{
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "target": "ES2015",
    "outDir": "out",
    "lib": ["ES2015"],
    "strict": true,
    "sourceMap": true,
    "rootDir": "src",
    "types": ["node", "vscode"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "src/**/*.mock.ts"]
}
